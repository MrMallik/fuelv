# Swappable Extraction Pipeline Configuration
# Options: "gemini" (default) or "custom" (for your future fine-tuned model)
EXTRACTOR_BACKEND=gemini

# Gemini Flash settings (used when EXTRACTOR_BACKEND=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Custom Fine-Tuned Model settings (used when EXTRACTOR_BACKEND=custom)
CUSTOM_EXTRACTOR_URL=http://localhost:8080/predict
CUSTOM_EXTRACTOR_MODEL_ID=custom-fuel-ft-v1
CUSTOM_EXTRACTOR_API_KEY=

# Database & Storage paths
FUELV_DB_PATH=data/fuelv.db
FUELV_IMAGES_DIR=data/images
